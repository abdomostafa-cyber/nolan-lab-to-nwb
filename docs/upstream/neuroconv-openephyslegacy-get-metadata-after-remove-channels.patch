From c85dad196b05b690f5ee399015439ac6ae5f4693 Mon Sep 17 00:00:00 2001
From: Abdalrhman Mostafa <abdomostafag10@gmail.com>
Date: Tue, 27 Oct 2026 03:19:13 +0300
Subject: [PATCH] Keep `OpenEphysLegacyRecordingInterface.get_metadata` working
 after `remove_channels`

`get_metadata` read the session start time through `recording_extractor.neo_reader`, which the
channel slice that `remove_channels` leaves in place of the recording does not carry. Keep the
reader in `__init__`, while the recording is still the neo extractor, as #2140 does for
`AxonRecordingInterface`.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 changelog_entries/PRNUMBER.bugfix.md                       | 1 +
 .../ecephys/openephys/openephyslegacydatainterface.py      | 7 +++++--
 tests/test_on_data/ecephys/test_openephyslegacy.py         | 7 +++++++
 3 files changed, 13 insertions(+), 2 deletions(-)
 create mode 100644 changelog_entries/PRNUMBER.bugfix.md

diff --git a/changelog_entries/PRNUMBER.bugfix.md b/changelog_entries/PRNUMBER.bugfix.md
new file mode 100644
index 0000000..a43d7d8
--- /dev/null
+++ b/changelog_entries/PRNUMBER.bugfix.md
@@ -0,0 +1 @@
+`OpenEphysLegacyRecordingInterface.get_metadata` no longer throws `AttributeError: 'ChannelSliceRecording' object has no attribute 'neo_reader'` after `remove_channels`, so a legacy Open Ephys session can be converted after dropping channels.
diff --git a/src/neuroconv/datainterfaces/ecephys/openephys/openephyslegacydatainterface.py b/src/neuroconv/datainterfaces/ecephys/openephys/openephyslegacydatainterface.py
index 73dfaa8..ada2809 100644
--- a/src/neuroconv/datainterfaces/ecephys/openephys/openephyslegacydatainterface.py
+++ b/src/neuroconv/datainterfaces/ecephys/openephys/openephyslegacydatainterface.py
@@ -124,6 +124,10 @@ class OpenEphysLegacyRecordingInterface(BaseRecordingExtractorInterface):
             metadata_key=metadata_key,
         )
 
+        # Keep the reader while the recording is still the neo-based extractor, as `remove_channels`
+        # replaces it with a channel slice that does not carry the `neo_reader`
+        self._neo_reader = self.recording_extractor.neo_reader
+
     def get_metadata(self, *, use_new_metadata_format: bool = True) -> DeepDict:
         metadata = super().get_metadata(use_new_metadata_format=use_new_metadata_format)
 
@@ -134,8 +138,7 @@ class OpenEphysLegacyRecordingInterface(BaseRecordingExtractorInterface):
             # pipeline synthesizes its defaults from the channel-group properties.
             metadata["Ecephys"]["ElectricalSeries"][self.metadata_key]["name"] = "ElectricalSeries"
 
-        neo_reader = self.recording_extractor.neo_reader
-        block_annotations = neo_reader.raw_annotations.get("blocks", [])
+        block_annotations = self._neo_reader.raw_annotations.get("blocks", [])
         if block_annotations:
             segment_annotations = block_annotations[0].get("segments", [])
             if segment_annotations:
diff --git a/tests/test_on_data/ecephys/test_openephyslegacy.py b/tests/test_on_data/ecephys/test_openephyslegacy.py
index 228d93d..5f04710 100644
--- a/tests/test_on_data/ecephys/test_openephyslegacy.py
+++ b/tests/test_on_data/ecephys/test_openephyslegacy.py
@@ -49,3 +49,10 @@ class TestOpenEphysLegacyConversions(TestCase):
 
         assert "session_start_time" in metadata["NWBFile"]
         self.assertEqual(metadata["NWBFile"]["session_start_time"], datetime(2020, 4, 29, 0, 0))
+
+    def test_get_metadata_after_remove_channels(self):
+        session_start_time = self.interface.get_metadata()["NWBFile"]["session_start_time"]
+
+        self.interface.remove_channels(channel_ids=[self.interface.channel_ids[-1]])
+
+        assert self.interface.get_metadata()["NWBFile"]["session_start_time"] == session_start_time
-- 
2.33.0.windows.2

